# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Set to true only when served over HTTPS
SESSION_COOKIE_SECURE=false
SESSION_MINUTES=30

RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=300 per hour
RATELIMIT_STORAGE_URI=memory://

# First-run admin. There is no default password: if ADMIN_PASSWORD is blank, no admin is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=